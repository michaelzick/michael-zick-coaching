{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "michael-zick-coaching",
  "account_id": "0c4a1637a60ec527675c7e248b73e39d",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CLIENT_IP_HEADER": "CF-Connecting-IP"
  },
  "previews": {
    "vars": {
      "CLIENT_IP_HEADER": "CF-Connecting-IP"
    },
    "images": {
      "binding": "IMAGES"
    }
  },
  "observability": {
    "enabled": true
  }
}
