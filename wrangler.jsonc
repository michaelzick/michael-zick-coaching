{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "michaelzick-com",
  "account_id": "0c4a1637a60ec527675c7e248b73e39d",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CLIENT_IP_HEADER": "CF-Connecting-IP"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "michaelzick.com",
      "custom_domain": true
    },
    {
      "pattern": "www.michaelzick.com",
      "custom_domain": true
    }
  ]
}
